@page
@model Module4Challenge.Pages.BasePageModel 
@{
    ViewData["Title"] = "Dad Joke Generator";
}

<h1>DADs-R-US</h1>

<div class=container">
    <h2>Welcome to the Dad Joke Generator</h2>
    @for (int i = 0; i < @Model.jokesToShow.Length; i++){
        <div class="card">@Model.jokesToShow[i]</div>
    }
    <form method="post">
            <button type="submit" class="btn btn-primary">Show Me More Jokes!</button>

    </form>

</div>